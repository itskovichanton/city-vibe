# Профиль приложения (mybootstrap)
PROFILE=dev

# --- City Vibe infra feature flags ---
# Локально удобно держать «тяжёлые» фичи выключенными.

# Request-ID (asgi-correlation-id → X-Request-ID) — почти бесплатно, по умолчанию ON
CITYVIBE_REQUEST_ID_ENABLED=true
CITYVIBE_REQUEST_ID_HEADER=X-Request-ID

# S2S auth общим секретом (без TLS). ON — все роуты кроме skip-list требуют токен
CITYVIBE_S2S_AUTH_ENABLED=false
CITYVIBE_S2S_TOKEN=dev-s2s-token
CITYVIBE_S2S_HEADER=X-Service-Token
CITYVIBE_S2S_SKIP_PATHS=/health,/docs,/redoc,/openapi.json

# Idempotency-Key на create/update (нужен Redis)
CITYVIBE_IDEMPOTENCY_ENABLED=false
CITYVIBE_IDEMPOTENCY_TTL_SEC=86400
CITYVIBE_IDEMPOTENCY_HEADER=Idempotency-Key

# Rate limit через pyrate-limiter + Redis
CITYVIBE_RATE_LIMIT_ENABLED=false
CITYVIBE_RATE_LIMIT_DEFAULT=60
CITYVIBE_RATE_LIMIT_WINDOW_SEC=60

# Валидация upload (размер + filetype MIME sniff) — безопасно держать ON
CITYVIBE_UPLOAD_VALIDATION_ENABLED=true
CITYVIBE_UPLOAD_MAX_BYTES=5242880
CITYVIBE_UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/jpg

# Transactional outbox (нужна таблица outbox_messages)
CITYVIBE_OUTBOX_ENABLED=false
CITYVIBE_OUTBOX_POLL_SEC=2

# OpenTelemetry → Jaeger (UI http://localhost:16686, нужен make infra-up)
# CITYVIBE_OTEL_SERVICE_NAME задаётся per-service (make run-* / start_all.sh); пример ниже — для user-service
CITYVIBE_TRACING_ENABLED=true
CITYVIBE_OTEL_ENDPOINT=http://localhost:4317
CITYVIBE_OTEL_SERVICE_NAME=user-service

# Redis (idempotency + rate-limit)
CITYVIBE_REDIS_URL=redis://localhost:6379/0

# Подробные HTTP-логи в файл каждого микросервиса (method/url/headers/body/status/timing)
# Путь: python/<service>/<app>-<ver>/work/<profile>/logs/http-<app>-<ver>-[<profile>].txt
CITYVIBE_HTTP_LOG_ENABLED=true
CITYVIBE_HTTP_LOG_MAX_BODY=1048576
CITYVIBE_HTTP_LOG_REQUEST_BODY=true
CITYVIBE_HTTP_LOG_RESPONSE_BODY=true
CITYVIBE_HTTP_LOG_SKIP_PATHS=/health,/docs,/redoc,/openapi.json,/favicon.ico

# --- Milana (DeepSeek NL → places/search) ---
# https://platform.deepseek.com — ключ НЕ коммитить
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 4096 достаточно для JSON-плана + короткого ответа; 8192 — для codegen
DEEPSEEK_MAX_TOKENS=4096
